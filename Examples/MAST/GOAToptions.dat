#=========================================================================#
#                                                                         #
#                       GENERAL GOAT OPTIONS                              #
#                                                                         #
#=========================================================================#
#-------------------------------------------------------------------------#
#                          MAIN OPTIONS                                   #
#-------------------------------------------------------------------------#
# General options
'goat.debug'                        '0'
'goat.meth'                         'GG'

# Input file locations 
#'goat.gridfilepath'                 'traduit.out.b2us_smoothed2'
#'goat.gridfilepath'                 'traduit.out.b2us_basegeom'
'goat.gridfilepath'                 'traduit.out.b2us'
'goat.magneticfieldfilepath'        'rzpsi.dat'
'goat.structurefilepath'            'structure.dat'
'goat.GDinputfilepath'              'GOAToptions.dat'

# Output file locations 
'goat.writefilepath'                'traduit.out.b2us'  

# Output options 
'goat.write_final'                  '1'
'goat.write_traduitb2us'            '1'
'goat.write_b2agdat'                '1'
'goat.write_Xpointdata'             '1'
'goat.write_OMPdata'                '0'
'goat.write_topologicaldata'        '0'

# Switches to identify case
'goat.vesselmode'                   '0'
'goat.slab'                         '0'
'goat.artificial_slab'              '0'

# OMP/IMP
'goat.OMP_r'                        '[0, 0]'
'goat.OMP_z'                        '[0, 0]'
'goat.IMP_r'                        '[0, 0]'
'goat.IMP_z'                        '[0, 0]'

#-------------------------------------------------------------------------#
#                          INTERFACING OPTIONS                            #
#-------------------------------------------------------------------------#
# Face label mappings between GG (grid generator) and GD (grid deformation)
# See Setgoat.m or InterfaceGAtoGD.m for a description of the GD 
# face label mappings. 
'goat.facelabelsubfrom'     '[]'
'goat.facelabelsubto'       '[]'
'goat.facelabelmappingGG' '[1:4, 5:18, -21]'
'goat.facelabelmappingGD' '[1*4, 4*14, 2]'
'goat.facelabelmappingGA' '[4, 5, 6, 7, 1*14, 2]'
#'goat.facelabelmappingGG'  '[1:23, 36:38, 25:27, 24, 28:35, 39:67, 68:70]'
#'goat.facelabelmappingGD'  '[5*23, 1*3, 1*3, 4*38, 5*3]'
# 'goat.facelabelmappingGG' '[1, 2, 36:38, 47:49, 36:103, 104:106]'
# 'goat.facelabelmappingGD' '[5, 5, 1*3, 1*3, 4*68, 5*3]'

#-------------------------------------------------------------------------#
#                          GRID OPTIONS                                   #
#-------------------------------------------------------------------------#
# Read method 
'goat.grid.readmeth'                'traduitb2us' 

# Grid type
'goat.grid.type'                    'plasma'

#-------------------------------------------------------------------------#
#                          MAGNETIC FIELD OPTIONS                         #
#-------------------------------------------------------------------------#
# Read method
'goat.mf.readmeth'                  'rzpsi'

# Interpolation options
'goat.mf.interpC'                   '3'
'goat.mf.interpM'                   '6'
'goat.mf.interpmeth'                'uniformgrid'

#-------------------------------------------------------------------------#
#                          VESSEL STRUCTURE OPTIONS                       #
#-------------------------------------------------------------------------#
# Environment (including vessel etc) options 
# Vessel geometry & reading method
'goat.vessel.readmeth'          'read_structure'

# Refinement options for vessel
'goat.vessel.refinevessel'          '1'
'goat.vessel.maxvesseldist'         '1e-3'

# Target plate definition
'goat.vessel.TP'                    '[1, 2]'
'goat.vessel.TPind'                 '[1, 2]'

# SOLPS divertor targets (structures the primary strike legs hit;
# required by the new GOAT primary-strike guard). MAST is a clean CDN.
'goat.vessel.solps_lower_divertor_inner_target'   '[1]'
'goat.vessel.solps_lower_divertor_outer_target'   '[4]'
'goat.vessel.solps_upper_divertor_inner_target'   '[2]'
'goat.vessel.solps_upper_divertor_outer_target'   '[3]'

# Structures to be excluded when constructing vessel (if empty, all are included)
'goat.vessel.exclude'               '[]'
#'goat.vessel.exclude'               '[1, 2, 3, 4, 5, 6, 7, 8]'

# Vessel field description (similar to magnetic field interpolant, 
# but for vessel - only used for vessel distance penalty, and if shape
# method is the same, also used for boundary constraints)
'goat.vessel.shapemeth'             'closedpolygon_exact'
'goat.vessel.resx'                  '100'
'goat.vessel.resy'                  '100'
'goat.vessel.offsetfracx'           '0.1'
'goat.vessel.offsetfracy'           '0.1'
'goat.vessel.interpC'               '3'
'goat.vessel.interpM'               '6'

#-------------------------------------------------------------------------#
#                          ADDITIONAL DATA                                #
#-------------------------------------------------------------------------#
# OMP and IMP
'goat.data.OMPr'                '[1.8 2.4]'
'goat.data.OMPz'                '[0 0]'
'goat.data.IMPr'                '[0.65 2]'
'goat.data.IMPz'                '[0 0]'

# Data
'goat.mf.RBtor'                '-0.524481590201664'

