'gg.ref.meth'                           'lengthbased'
#'gg.ref.meth'                           'no'
'gg.ref.LB.doxp'                        '1'
'gg.ref.LB.dovessel'                    '1'
'gg.ref.LB.Lmininf'                     '0.01'
'gg.ref.LB.Lmaxinf'                     '0.05'
'gg.ref.LB.structureIDs'                '[1, 2]'
'gg.ref.LB.Lminstructure'               '[0.002, 0.002]'
'gg.ref.LB.Lmaxstructure'               '[0.01, 0.01]'
'gg.ref.LB.decaylengthstructure'        '[0.2, 0.2]'
