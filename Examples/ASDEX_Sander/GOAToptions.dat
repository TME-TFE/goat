'gg.radref.LB.Lmaxinf'                     '1000.0'
'gg.radref.LB.Lminsp'                      '0.04'
'gg.radref.LB.Lmaxsp'                      '0.10'
'gg.radref.LB.decaylengthsp'               '0.5'


# Boundary layer options (only for length based refinement for now)
'gg.ref.BL.dotarget'                    '1'
#'gg.ref.BL.nctarget'                  '7'
#'gg.ref.BL.dltarget'                  '[0.002, 0.003, 0.004, 0.006, 0.008, 0.012, 0.016]'
'gg.ref.BL.nctarget'                  '4'
'gg.ref.BL.dltarget'                  '[0.002, 0.004, 0.008, 0.016]'
'gg.ref.BL.dovessel'                    '0'
'gg.ref.BL.ncvessel'                  '4'
'gg.ref.BL.dlvessel'                  '[0.002, 0.004, 0.008, 0.016]'
'gg.ref.BL.dllengthbased'             '1'

# 'Boundary' layer options for radial direction
'gg.radref.BL.dosp'                '1'
#'gg.radref.BL.ncsp'                '9'
#'gg.radref.BL.dlsp'                '[0.0010, 0.0015, 0.002, 0.003, 0.0045, 0.0067, 0.015, 0.015, 0.025]'
'gg.radref.BL.ncsp'                '5'
#'gg.radref.BL.dlsp'                '[0.0010, 0.002, 0.0045, 0.015, 0.025]'
'gg.radref.BL.dlsp'                '[0.0030, 0.0045, 0.006, 0.0075, 0.009]'
'gg.radref.BL.dllengthbased'       '0'

# Post-processing options
'gg.vd.removefluxsurfaces'              '1' # Remove too narrow flux surfaces
'gg.vd.removenarrowboundarytriangles'   '1' # Remove too narrow triangles at boundary and replace by cut cells

# Contour resolution 
'gg.vd.contouring.resx'         '400'
'gg.vd.contouring.resy'         '400'
'gg.vd.contouring.coarsen'      '0'

# Orthogonal line tracer options (only if orthogonal based GG is used)
'gg.vd.orthlinetracing.step'    '1' # relative step size (larger = less accurate but faster)
'gg.vd.orthlinetracing.nsteps'  '500' # maximal number of steps to take 


# Distribution of vertices on flux surfaces (poloidal)
'gg.vd.pd.type'                         'densitybased'

# Options for uniform distribution
'gg.vd.pd.distribution.facelength'      '16e-1';

'gg.vd.rd.distribution.fieldwidth'      '8e0';

# Options for density based distribution
'gg.vd.pd.distribution.plftype'            'none'
'gg.vd.pd.distribution.decaylengthplf'     '1.00'
'gg.vd.pd.distribution.densityatvessel' '50'
'gg.vd.pd.distribution.densityatinf'    '5'
#'gg.vd.pd.distribution.points.x'        '[11.368472389667550, 5.6083687434207787]'
#'gg.vd.pd.distribution.points.y'        '[2.5613748574976336, 2.3667529636363636]'
#'gg.vd.pd.distribution.points.d'        '[0.1, 0.1]'
#'gg.vd.pd.distribution.points.val'      '[25, 25]'


# Distribution of flux surfaces (radial)
'gg.vd.rd.type'                         'densitybased'
